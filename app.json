{
  "expo": {
    "name": "FEAT",
    "slug": "feat",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "prestamos",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#060709",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.miles12.feat"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "48a091c9-df6c-4572-85d1-bdb96a616a7d"
      }
    },
    "owner": "miles12"
  }
}
